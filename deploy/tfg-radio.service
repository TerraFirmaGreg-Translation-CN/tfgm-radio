[Unit]
Description=TFG Navidrome random radio stream
After=network-online.target navidrome.service
Wants=network-online.target

[Service]
User=radio
EnvironmentFile=/etc/tfg-radio.env
ExecStart=/usr/bin/python3 /opt/tfg-radio/radio.py --navidrome-url http://127.0.0.1:4533 --user radio --listen 0.0.0.0:8080 --token CHANGEME
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
